{
    "schemaVersion": 1,
    "id": "renewables",
    "version": "${version}",
    "name": "renewables",
    "description": "Makes certain items and blocks renewable.",
    "authors": [
        "Scillman"
    ],
    "contact": {
        "homepage": "https://github.com/Scillman/mc-scillman-renewables/",
        "sources": "https://github.com/Scillman/mc-scillman-renewables/",
        "issues": "https://github.com/Scillman/mc-scillman-renewables/"
    },
    "license": "MIT",
    "icon": "assets/renewables/icon.png",
    "environment": "*",
    "entrypoints": {
        "fabric-datagen": [
            "com.github.scillman.minecraft.renewables.datagen.ModDataGenerator"
        ]
    },
    "mixins": [
        "renewables.mixins.json"
    ],
    "depends": {
        "fabricloader": ">=${loader_version}",
        "minecraft": "~${minecraft_version}",
        "java": ">=21",
        "fabric-api": "*"
    }
}